---
import Layout from "../layouts/Layout.astro";
import { Schedule } from "../components/Schedule/Schedule";
import { ScheduleFilters } from "../components/Schedule/ScheduleFilters";
---

<style>
  .gradient-bg {
    background: linear-gradient(135deg, #f05123 0%, #ff6b3d 100%);
  }

  .faq-item {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
  }

  .faq-item:hover {
    border-color: rgba(255, 107, 0, 0.3);
    transform: translateY(-2px);
  }

  .faq-item.active {
    border-color: #ff6b00;
    box-shadow:
      0 10px 25px -5px rgba(255, 107, 0, 0.1),
      0 8px 10px -6px rgba(255, 107, 0, 0.1);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item.active .faq-icon {
    transform: rotate(180deg);
  }

  .faq-icon {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #ff6b00;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #e65a00;
  }
</style>

<Layout>
  <!-- Page Hero -->
  <section class="gradient-bg text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-5xl font-bold mb-4">
        ¡Tu próxima clase te está esperando!
      </h2>
      <p class="text-xl max-w-2xl mx-auto">
        Ritmo Vivo y Social Club te abren sus pistas para aprender y gozar.
        Encuentra tu nivel, tu estilo y tu nueva comunidad.
      </p>
    </div>
  </section>

  <section class="py-10">
    <div class="container mx-auto px-4">
      <div class="text-center mb-0">
        <h3 class="text-4xl font-bold text-gray-800 mb-4">
          📅 Horarios de Clases
        </h3>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Encuentra la clase perfecta para ti. Todos los niveles, todos los
          ritmos.
        </p>
      </div>
    </div>
  </section>

  <!-- Filters Section -->
  <ScheduleFilters client:load />

  <!-- Schedule Section - Social Club -->
  <section class="py-12">
    <div class="container mx-auto px-4">
      <Schedule client:load />
    </div>
  </section>

  <!-- Quick Info Banner -->
  <section class="py-6 bg-linear-to-r from-orange-100 to-red-100">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-6 text-center">
        <div class="flex items-center gap-2">
          <span class="text-3xl">💳</span>
          <div class="text-left">
            <div class="font-bold text-gray-800">Métodos de Pago</div>
            <div class="text-sm text-gray-600">
              Efectivo, tarjeta, Transferencia
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-3xl">🎁</span>
          <div class="text-left">
            <div class="font-bold text-gray-800">Descuentos</div>
            <div class="text-sm text-gray-600">
              Individual, referidos, bonos
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Pricing Section - Clases -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h3 class="text-4xl font-bold text-gray-800 mb-4">💃 Paquetes</h3>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Todos los paquetes tienen una vigencia de dos meses.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8 max-w-7xl mx-auto">
        <!-- Plan 1: Clase Privada -->
        <div
          class="pricing-card bg-white rounded-2xl shadow-lg overflow-hidden"
        >
          <div class="bg-gray-100 p-6 text-center">
            <div class="text-4xl mb-3">🎯</div>
            <h4 class="text-2xl font-bold text-gray-800 mb-2">Clase Privada</h4>
            <p class="text-sm text-gray-600">Perfecta para probar</p>
          </div>
          <div class="p-8">
            <div class="text-center mb-6">
              <div class="price-tag text-gray-800">
                <span class="text-2xl">$90.000</span>
              </div>
              <div class="text-gray-600 text-sm">
                Pareja (2 personas): $110.000 <br />
                Persona adicional: $20.000
              </div>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">1 hora de clase</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Cualquier género musical</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700">
                  Lunes a viernes : 9:00am a 5:00pm
                </span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700">Sábado de 9:00am a 1:00pm</span>
              </li>
            </ul>
            <a
              href="https://wa.me/573009853900?text=Hola%2C%20quiero%20comprar%20una%20clase%20individual"
              class="block w-full text-center py-3 border-2 border-sc-orange text-sc-orange rounded-xl font-semibold hover:bg-sc-orange hover:text-white transition"
            >
              Comprar
            </a>
          </div>
        </div>

        <!-- Plan 2: Mensualidad -->
        <div
          class="pricing-card bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-sc-orange"
        >
          <div class="gradient-bg p-6 text-center text-white">
            <div class="text-4xl mb-3">⭐</div>
            <h4 class="text-2xl font-bold mb-2">Paquete por 5 horas</h4>
            <p class="text-sm">Más popular</p>
          </div>
          <div class="p-8">
            <div class="text-center mb-6">
              <div class="price-tag text-sc-orange">
                <span class="text-2xl">$400.000</span>
              </div>
              <div class="text-gray-600 text-sm">Para 2 personas: $500.000</div>
              <div
                class="mt-2 inline-block bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Ahorras $50.000
              </div>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Puedes programar hasta 2 hora de clase por día</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Cualquier género musical</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Vigencia de 2 meses</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700"
                  >Lunes a viernes : 9:00am a 5:00pm</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700">Sábado de 9:00am a 1:00pm</span>
              </li>
            </ul>
            <a
              href="https://wa.me/573009853900?text=Hola%2C%20quiero%20comprar%20la%20mensualidad"
              class="block w-full text-center py-3 gradient-bg text-white rounded-xl font-semibold hover:shadow-lg transition"
            >
              Comprar Ahora
            </a>
          </div>
        </div>

        <!-- Plan 3: Trimestre -->
        <div
          class="pricing-card bg-white rounded-2xl shadow-lg overflow-hidden"
        >
          <div class="bg-purple-600 p-6 text-center text-white">
            <div class="text-4xl mb-3">🎓</div>
            <h4 class="text-2xl font-bold mb-2">Paquete por 10 horas</h4>
            <p class="text-sm">Mejor inversión</p>
          </div>
          <div class="p-8">
            <div class="text-center mb-6">
              <div class="price-tag text-purple-600">
                <span class="text-2xl">$750.000</span>
              </div>
              <div class="text-gray-600 text-sm">Para 2 personas: $950.000</div>
              <div
                class="mt-2 inline-block bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Ahorras $140.000
              </div>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Puedes programar hasta 2 hora de clase por día</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Cualquier género musical</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Vigencia de 2 meses</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700"
                  >Lunes a viernes : 8:00am a 5:00pm</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-700">Sábado de 10:00am a 1:00pm</span>
              </li>
            </ul>
            <a
              href="https://wa.me/573009853900?text=Hola%2C%20quiero%20comprar%20el%20plan%20trimestral"
              class="block w-full text-center py-3 bg-purple-600 text-white rounded-xl font-semibold hover:bg-purple-700 transition"
            >
              Comprar
            </a>
          </div>
        </div>

        <!-- Plan 4: Ilimitado -->
        <div
          class="pricing-card bg-white rounded-2xl shadow-lg overflow-hidden"
        >
          <div
            class="bg-linear-to-r from-yellow-500 to-orange-500 p-6 text-center text-white"
          >
            <div class="text-4xl mb-3">👑</div>
            <h4 class="text-2xl font-bold mb-2">Clases empresariales</h4>
            <p class="text-sm">Para dedicados</p>
          </div>
          <div class="p-8">
            <div class="text-center mb-6">
              <div class="price-tag text-orange-500">
                <span class="text-2xl">$90.000</span>
              </div>
              <div class="text-gray-600 text-sm">
                Para 2 personas: $110.000 <br />
                Persona Adicional: $20.000
              </div>
              <div
                class="mt-2 inline-block bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Mejor valor
              </div>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Cualquier género musical</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Horario: Tu eliges el día y la hora</span
                >
              </li>
            </ul>
            <a
              href="https://wa.me/573009853900?text=Hola%2C%20quiero%20el%20plan%20ilimitado"
              class="block w-full text-center py-3 bg-gradient-to-r from-yellow-500 to-orange-500 text-white rounded-xl font-semibold hover:shadow-lg transition"
            >
              Comprar
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Descuentos Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h3 class="text-4xl font-bold text-gray-800 mb-4">
          🎁 Descuentos Especiales
        </h3>
        <p class="text-gray-600">Aprovecha nuestros descuentos y ahorra más</p>
      </div>

      <div class="grid md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div
          class="bg-linear-to-br from-blue-50 to-blue-100 rounded-2xl p-8 text-center"
        >
          <div class="text-6xl mb-4">🎓</div>
          <h4 class="text-2xl font-bold mb-3 text-gray-800">
            Bono de cumpleaños
          </h4>
          <div class="text-5xl font-bold text-blue-600 mb-4">20%</div>
          <p class="text-gray-700 mb-4">Este descuento es acumulable</p>
          <p class="text-sm text-gray-600">
            *Ingresa el código al momento de la compra
          </p>
        </div>

        <div
          class="bg-linear-to-br from-pink-50 to-pink-100 rounded-2xl p-8 text-center"
        >
          <div class="text-6xl mb-4">👥</div>
          <h4 class="text-2xl font-bold mb-3 text-gray-800">
            Referido para curso grupal
          </h4>
          <div class="text-5xl font-bold text-pink-600 mb-4">5%</div>
          <p class="text-gray-700 mb-4">acumulable</p>
          <p class="text-sm text-gray-600">
            *Referido tiene que ser un tercero, no puede ser tu pareja
          </p>
        </div>

        <div
          class="bg-linear-to-br from-purple-50 to-purple-100 rounded-2xl p-8 text-center"
        >
          <div class="text-6xl mb-4">💑</div>
          <h4 class="text-2xl font-bold mb-3 text-gray-800">Grupos</h4>
          <div class="text-5xl font-bold text-purple-600 mb-4">15%</div>
          <p class="text-gray-700 mb-4">si tomas 3 o más cursos.</p>
          <p class="text-sm text-gray-600">
            *Solo aplica en mensualidad individual
          </p>
        </div>

        <div
          class="bg-linear-to-br from-purple-50 to-purple-100 rounded-2xl p-8 text-center"
        >
          <div class="text-6xl mb-4">💑</div>
          <h4 class="text-2xl font-bold mb-3 text-gray-800">2x1</h4>
          <!-- <div class="text-5xl font-bold text-purple-600 mb-4">15%</div> -->
          <p class="text-gray-700 mb-4">
            <!-- si tomas 3 o más cursos si adquieres. 5% si tomas 2 cursos -->
          </p>
          <p class="text-sm text-gray-600">
            *Solo aplica para el primer mes del curso
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Payment Methods -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h3 class="text-3xl font-bold text-gray-800 mb-8">
          💳 Métodos de Pago
        </h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="text-4xl mb-3">💵</div>
            <div class="font-bold text-gray-800">Efectivo</div>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="text-4xl mb-3">💳</div>
            <div class="font-bold text-gray-800">Tarjeta</div>
            <div class="text-xs text-gray-600 mt-1">Débito/Crédito</div>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="text-4xl mb-3">🏦</div>
            <div class="font-bold text-gray-800">Transferencia</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-linear-to-br from-orange-50 to-red-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h3 class="text-3xl font-bold text-gray-800 mb-8 text-center">
          ❓ Preguntas Frecuentes
        </h3>

        <div class="space-y-4">
          <!-- FAQ Item 1 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Puedo recuperar una clase si la pierdo?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                Si tienes clase privada o paquete, puedes reponer la clase
                siempre y cuando la canceles con mínimo 2 horas de anticipación.
                Si la cancelación se realiza fuera de este tiempo, la clase se
                dará por tomada. En los cursos grupales no es posible reponer la
                clase, ya que el grupo lleva una continuidad en el proceso. Sin
                embargo, no te preocupes: en el grupo de WhatsApp siempre
                compartimos los videos con los temas vistos en clase, y el
                profesor inicia cada sesión con un repaso y la resolución de
                dudas. En caso de que Social Club o el profesor deban cancelar
                la clase, esta se repondrá sin ningún inconveniente.
              </div>
            </div>
          </div>

          <!-- FAQ Item 2 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Hay algún problema si en la promo 2x1 se inscriben dos hombres
                o dos mujeres?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                ¡Para nada! La promo 2x1 aplica para una pareja de baile, sin
                importar el género. Lo único importante es que haya un rol
                definido: un líder y un seguidor. Dos chicas o dos chicos son
                más que bienvenidos. Solo les pedimos decidir antes quién será
                líder y quién seguidor durante el mes, para mantener el
                equilibrio del grupo.
              </div>
            </div>
          </div>

          <!-- FAQ Item 3 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Debo inscribirme en todos los cursos con la misma pareja?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                Para nada. Puedes cambiar de pareja entre cursos sin afectar tu
                proceso. Lo importante es que te sientas cómodo y disfrutes
                aprender.
              </div>
            </div>
          </div>

          <!-- FAQ Item 4 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Puedo congelar mi mensualidad o mi paquete de clases?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                Sí, puedes congelar tu proceso. Solo debes avisarnos antes para
                revisar tu caso. Una vez aprobado, puedes congelar hasta por 2
                meses máximo.
              </div>
            </div>
          </div>

          <!-- FAQ Item 5 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Cuánto dura cada clase de un curso grupal?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                Cada mensualidad incluye 4 clases, de 1 hora y media cada una.
                Las clases son una vez por semana.
              </div>
            </div>
          </div>

          <!-- FAQ Item 6 -->
          <div
            class="faq-item bg-white rounded-xl shadow-md overflow-hidden"
            onclick="toggleFAQ(this)"
          >
            <div
              class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 transition"
            >
              <h4 class="font-bold text-gray-800 pr-8">
                ¿Necesito llevar pareja?
              </h4>
              <svg
                class="faq-icon w-6 h-6 text-sc-orange shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
            <div class="faq-answer">
              <div class="px-6 pb-6 text-gray-600">
                No es necesario. Puedes pagar tu mensualidad individual y, si en
                clase hay un líder disponible, tomas la sesión con esa persona.
