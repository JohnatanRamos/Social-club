---
import Layout from "../layouts/Layout.astro";
import { ReservationForm } from "../components/Reservations/ReservationForm";
---

<Layout>
  <!-- Reservation Section -->
  <section
    id="reservar"
    class="py-20 bg-linear-to-br from-orange-100 to-red-100"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h3 class="text-4xl font-bold text-gray-800 mb-4">
            ¿Dónde nos vemos hoy?
          </h3>
          <p class="text-gray-600 text-lg">
            Dos espacios, miles de experiencias. Selecciona tu vibra y reserva
            en el lugar que va con tu mood
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-2xl p-8 md:p-12">
          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <!-- Benefits -->
            <div>
              <h4 class="text-2xl font-bold mb-6 text-gray-800">
                ¿Por qué Reservar?
              </h4>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div
                    class="w-8 h-8 gradient-bg rounded-full flex items-center justify-center flex-shrink-0"
                  >
                    <span class="text-white font-bold">✓</span>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-800">
                      Rumba Asegurada:
                    </div>
                    <div class="text-gray-600 text-sm">
                      Ambientes que estallan de energía, DJs y música en vivo,
                      bailarines, shows y una comunidad que siempre llega con
                      toda.
                    </div>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <div
                    class="w-8 h-8 gradient-bg rounded-full flex items-center justify-center flex-shrink-0"
                  >
                    <span class="text-white font-bold">✓</span>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-800">
                      Comida Deliciosa:
                    </div>
                    <div class="text-gray-600 text-sm">
                      Opciones para todos los antojos.
                    </div>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <div
                    class="w-8 h-8 gradient-bg rounded-full flex items-center justify-center flex-shrink-0"
                  >
                    <span class="text-white font-bold">✓</span>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-800">
                      Experiencias Personalizadas:
                    </div>
                    <div class="text-gray-600 text-sm">
                      Cumpleaños, cenas, reuniones,grados, despedidas de
                      soltero… arma tu plan y nosotros lo hacemos brillar.
                    </div>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <div
                    class="w-8 h-8 gradient-bg rounded-full flex items-center justify-center flex-shrink-0"
                  >
                    <span class="text-white font-bold">✓</span>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-800">
                      Ubicaciones que rompen:
                    </div>
                    <div class="text-gray-600 text-sm">
                      Un pedazo de Cartagena en Envigado, una rumba icónica bajo
                      un puente en Medellín, dos ambientes que no vas a
                      encontrar en ningún otro lado.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Pricing -->
            <div>
              <h4 class="text-2xl font-bold mb-6 text-gray-800">Precios</h4>
              <div class="space-y-4">
                <div class="bg-gray-50 rounded-xl p-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-800">SOCIAL</span>
                    <span class="text-2xl font-bold text-sc-orange"
                      >$25.000</span
                    >
                  </div>
                  <div class="text-sm text-gray-600">
                    Consumo mínimo 25.000 por persona
                  </div>
                </div>

                <div class="bg-gray-50 rounded-xl p-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-800">RITMO</span>
                    <span class="text-2xl font-bold text-sc-orange"
                      >$40.000</span
                    >
                  </div>
                  <div class="text-sm text-gray-600">
                    Consumo mínimo 40.000 por persona
                  </div>
                </div>

                <div
                  class="bg-yellow-50 rounded-xl p-4 border-2 border-yellow-300"
                >
                  <div class="text-sm text-yellow-700">
                    Deben realizar el abono por el 100% del consumo mínimo
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="border-t border-gray-200 pt-8 text-center">
            <p class="text-gray-600 mb-6">
              Aquí siempre pasa algo brutal. Aquí la rumba está asegurada.
            </p>
            <ReservationForm client:load variant="gradient" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dress Code & Rules -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h3 class="text-4xl font-bold text-center mb-12 text-gray-800">
          Políticas Social Club
        </h3>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Dress Code -->
          <div class="bg-gray-50 rounded-2xl p-8">
            <div class="text-4xl mb-4">ℹ️</div>
            <h4 class="text-2xl font-bold mb-4 text-gray-800">
              Políticas Social Club
            </h4>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">Edad mínima: 18 años</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Documento: Cédula o pasaporte obligatorio</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Reservas: Se toman hasta las 4:00pm si es para el mismo día</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Parqueadero: al lado de Social Club</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Reserva sin abono no queda confirmada</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >La ubicación de la reserva es sujeta a disponibilidad
                </span>
              </div>
            </div>
          </div>

          <!-- Rules -->
          <div class="bg-gray-50 rounded-2xl p-8">
            <div class="text-4xl mb-4">ℹ️</div>
            <h4 class="text-2xl font-bold mb-4 text-gray-800">
              Políticas Ritmo Vivo
            </h4>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Los menores de edad solo pueden estar hasta las 9:30pm</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Reservas: Se toman hasta las 4:00pm si es para el mismo día</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700">No contamos con Parqueadero</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >Reserva sin abono no queda confirmada</span
                >
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 text-xl">✓</span>
                <span class="text-gray-700"
                  >La ubicación de la reserva es sujeta a disponibilidad
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 gradient-bg text-white">
    <div class="container mx-auto px-4 text-center">
      <h3 class="text-4xl md:text-5xl font-bold mb-10">
        Aquí la rumba está asegurada.
      </h3>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <ReservationForm client:load variant="white" />
        <a
          href="eventos"
          class="inline-block bg-transparent border-2 border-white text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-white hover:text-sc-orange transition"
        >
          📅 Ver Próximos Eventos
        </a>
      </div>
    </div>
  </section>
</Layout>
